{
  "$schema": "qsobridge-profile/v1",
  "id": "cqwpx",
  "schemaVersion": "1.0",
  "meta": {
    "author": "QSObridge",
    "source": "reglement",
    "updated": "2026-07-27"
  },
  "label": {
    "nl": "CQ WPX",
    "fr": "CQ WPX",
    "en": "CQ WPX"
  },
  "targetFormat": "cabrillo",
  "contestTag": {
    "CW": "CQ-WPX-CW",
    "SSB": "CQ-WPX-SSB",
    "RTTY": "CQ-WPX-RTTY"
  },
  "modes": [
    "CW",
    "SSB",
    "RTTY"
  ],
  "requiredQsoFields": [
    "call",
    "datetime",
    "band",
    "mode",
    "rstSent",
    "rstRcvd",
    "serialSent"
  ],
  "header": {
    "required": [
      "stationCall",
      "location"
    ],
    "optional": [
      "club"
    ]
  },
  "exchange": {
    "stationType": {
      "field": "none",
      "on": "ALL"
    },
    "sent": {
      "ALL": [
        "rstSent",
        "serialSent"
      ]
    },
    "rcvd": {
      "ALL": [
        "rstRcvd",
        "serialRcvd"
      ]
    }
  },
  "validation": {
    "serialSent": {
      "type": "int",
      "min": 1,
      "required": true
    }
  },
  "filenamePattern": "{stationCall}.cbr",
  "notes": {
    "nl": "RST + volgnummer. Prefix = multiplier.",
    "fr": "RST + numéro. Préfixe = multiplicateur.",
    "en": "RST + serial. Prefix = multiplier."
  }
}