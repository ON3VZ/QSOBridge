        "rstRcvd",
        "state"
      ]
    }
  },
  "validation": {},
  "filenamePattern": "{stationCall}.cbr",
  "notes": {
    "nl": "DX-perspectief (bv. ON): verzonden = RST + vermogen (extras.TX_PWR); ontvangen = RST + staat/provincie. W/VE-operators wisselen dit om.",
    "fr": "Perspective DX: envoyé = RST + puissance; reçu = RST + état/province.",
    "en": "DX perspective (e.g. ON): sent = RST + power (extras.TX_PWR); rcvd = RST + state/province. W/VE ops swap these."
