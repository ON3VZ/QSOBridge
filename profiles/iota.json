{
  "$schema": "qsobridge-profile/v1",
  "id": "iota",
  "schemaVersion": "1.0",
  "meta": {
    "author": "QSObridge",
    "source": "rsgbcc.org",
    "updated": "2026-07-27"
  },
  "label": {
    "nl": "RSGB IOTA-contest",
    "fr": "Concours RSGB IOTA",
    "en": "RSGB IOTA contest"
  },
  "targetFormat": "cabrillo",
  "contestTag": {
    "CW": "RSGB-IOTA",
    "SSB": "RSGB-IOTA"
  },
  "modes": [
    "CW",
    "SSB"
  ],
  "requiredQsoFields": [
    "call",
    "datetime",
    "band",
    "mode",
    "rstSent",
    "rstRcvd",
    "serialSent"
  ],
  "header": {
    "required": [
      "stationCall",
      "categories.time"
    ],
    "optional": [
      "categories.overlay"
    ]
  },
  "exchange": {
    "stationType": {
      "field": "none",
      "on": "ALL"
    },
    "sent": {
      "ALL": [
        "rstSent",
        "serialSent",
        "myIota"
      ]
    },
    "rcvd": {
      "ALL": [
        "rstRcvd",
        "serialRcvd",
        "iota"
      ]
    }
  },
  "validation": {
    "iota": {
      "validator": "iota"
    },
    "categories.time": {
      "enum": [
        "12-HOURS",
        "24-HOURS"
      ],
      "required": true
    }
  },
  "filenamePattern": "{stationCall}.cbr",
  "notes": {
    "nl": "RST + volgnummer + IOTA-ref (aa-nnn of ------). CATEGORY-TIME verplicht.",
    "fr": "RST + numéro + réf IOTA. CATEGORY-TIME obligatoire.",
    "en": "RST + serial + IOTA ref (aa-nnn or ------). CATEGORY-TIME required."
  }
}